<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.example.ekhata.util.AppUtil.FormatUtils"/>
        <import type="com.example.ekhata.util.AppUtil.DateUtils"/>

        <variable
            name="customer"
            type="com.example.ekhata.features.customer.domain.model.Customer" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:cardCornerRadius="6dp"
        app:strokeColor="#EEEEEE"
        android:layout_marginBottom="6dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/NameLastDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/CustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="@{customer.name}"/>

                <TextView
                    android:id="@+id/LastDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:text='@{"Last: " + DateUtils.getTimeAgo(customer.createdAt)}'
                    android:textStyle="bold"
                    android:textColor="#949292"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/PendingAmount"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentEnd="true">

                <TextView
                    android:id="@+id/amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text='@{FormatUtils.formatAmount(customer.totalPendingAmount)}'
                    android:textSize="20sp"
                    android:textColor="#E91E63"
                    android:textStyle="bold"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"/>

                <TextView
                    android:id="@+id/PendingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pending"
                    android:textSize="14sp"
                    android:textColor="#949292"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    />

            </LinearLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>